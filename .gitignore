# Python
__pycache__/
*.pyc
*.pyo

# MLflow tracking artifacts (created wherever training.py is run from)
mlflow.db
mlruns/

# Downloaded structure data (~80GB) — never meant for git
data/

# Large binary model checkpoints (~443MB across 6-7 models) — not meant for git.
# Logs, CSVs, audit reports, and plots under results/ ARE tracked — they are
# small (<40MB total) and useful as a record of what each run actually produced.
results/models/*/*.pt

# IDE / tool state — khong dua vao repo public (R1-W6)
.idea/
.qodo/
.cadence/
.vscode/

# Kaggle output tai ve de kiem tra thu cong (checkpoint/data giai nen tu
# .zip download) — khong meant cho git, qua nang va la ban sao cuc bo.
# "_output_*" (khong chi "_output_/") vi trinh duyet/file manager tu them hau
# to khi tai nhieu file trung ten, vd "_output_ Gnina_Dense".
_output_*/
*.zip
*.txt
!requirements.txt
